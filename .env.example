# ============================================================
# Stocked — environment variables
# Copy to .env.local for development; set the same names in Vercel for production.
# NEVER commit .env.local. The full list with what each one does is
# src/lib/env-vars.json; check a file with: node scripts/check-env.js [file]
# ============================================================

# ── Required ────────────────────────────────────────────────────────────────
# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # secret: bypasses row-level security

# Public address of the site (production: https://www.stocked.tech)
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# Nightly jobs in vercel.json send this; generate with: openssl rand -hex 32
CRON_SECRET=

# Email (Resend)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Stocked <notifications@stocked.tech>

# Secret for the one-trial-per-email fingerprints; generate with: openssl rand -hex 32
# Set once before launch and NEVER change it: a new value forgets who already had a trial.
TRIAL_HASH_PEPPER=

# Lemon Squeezy — Settings → API, the store id, and the webhook signing secret
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Variant id from INSIDE each product (not the product id), per plan/region/interval
LEMONSQUEEZY_VARIANT_STARTER_STANDARD=
LEMONSQUEEZY_VARIANT_STARTER_STANDARD_ANNUAL=
LEMONSQUEEZY_VARIANT_STARTER_ASEAN=
LEMONSQUEEZY_VARIANT_STARTER_ASEAN_ANNUAL=
LEMONSQUEEZY_VARIANT_PRO_STANDARD=
LEMONSQUEEZY_VARIANT_PRO_STANDARD_ANNUAL=
LEMONSQUEEZY_VARIANT_PRO_ASEAN=
LEMONSQUEEZY_VARIANT_PRO_ASEAN_ANNUAL=
LEMONSQUEEZY_VARIANT_TOOLS_STANDARD=
LEMONSQUEEZY_VARIANT_TOOLS_STANDARD_ANNUAL=
LEMONSQUEEZY_VARIANT_TOOLS_ASEAN=
LEMONSQUEEZY_VARIANT_TOOLS_ASEAN_ANNUAL=

# ── Recommended ─────────────────────────────────────────────────────────────
# Who may open /api/admin/* (metrics, config check). Comma-separated. Unset = nobody.
PLATFORM_ADMIN_EMAILS=
# In-app Help chat
ANTHROPIC_API_KEY=
# Rate limits shared across servers (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Error reports (Sentry); the last three upload source maps at build time
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Optional ────────────────────────────────────────────────────────────────
# Custom Enterprise deals: comma-separated variant ids
LEMONSQUEEZY_VARIANT_ENTERPRISE=
# Wider barcode lookups
UPCITEMDB_API_KEY=
# "on" = delete paused accounts after 90 days; anything else = warn only
RETENTION_PURGE=
# Restricts sign-up to one email domain. Leave EMPTY for a public launch.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=
